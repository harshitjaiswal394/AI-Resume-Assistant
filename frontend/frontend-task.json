{
  "family": "frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::716608655181:role/AmazonECSTaskExecutionRolePolicy",
  "taskRoleArn": "arn:aws:iam::716608655181:role/ECSTaskRole",
  "containerDefinitions": [
    {
      "name": "frontend-container",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [
        {
          "name": "frontend-80",
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:80/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}