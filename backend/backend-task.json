{
  "family": "backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::716608655181:role/AmazonECSTaskExecutionRolePolicy",
  "taskRoleArn": "arn:aws:iam::716608655181:role/ECSTaskRole",
  "containerDefinitions": [
    {
      "name": "backend-container",
      "image": "716608655181.dkr.ecr.us-east-1.amazonaws.com/jobgpt-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "name": "backend-8000",
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NVIDIA_API_KEY",
          "value": "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"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jobgpt-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}